<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<!-- Meta AI sends the user back here after they approve the app. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.example.voicebridge</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>voicebridge</string>
			</array>
		</dict>
	</array>

	<!-- Meta Wearables Device Access Toolkit configuration. -->
	<key>MWDAT</key>
	<dict>
		<key>AppLinkURLScheme</key>
		<string>voicebridge://</string>
		<!-- Real values live in Local.xcconfig, which is gitignored. -->
		<key>MetaAppID</key>
		<string>$(META_APP_ID)</string>
		<key>ClientToken</key>
		<string>$(META_CLIENT_TOKEN)</string>
		<key>TeamID</key>
		<string>$(DEVELOPMENT_TEAM)</string>
	</dict>

	<!-- Required to talk to the glasses as an external accessory. -->
	<key>UISupportedExternalAccessoryProtocols</key>
	<array>
		<string>com.meta.ar.wearable</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<!-- Keeps the microphone alive in hands-free mode when the screen locks. -->
		<string>audio</string>
		<string>bluetooth-peripheral</string>
		<string>external-accessory</string>
	</array>

	<!--
	  The listener is plain HTTP on a private network, which iOS blocks by
	  default. NSAllowsLocalNetworking alone is not enough: it only exempts
	  .local hostnames and link-local addresses, not private IPs like
	  192.168.x.x or a Tailscale 100.x address, which is what you actually type
	  into Settings.

	  Arbitrary loads are therefore allowed, but only for app traffic — web
	  content stays protected. This is safe here because the app talks to
	  exactly one host, the one you configure, and every request is signed with
	  HMAC-SHA256 so the Mac rejects anything it did not expect. Over Tailscale
	  the traffic is also inside a WireGuard tunnel, so it is encrypted on the
	  wire despite being HTTP.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<!--
		  NSAllowsArbitraryLoads MUST be the only key here. Apple ignores it
		  entirely if NSAllowsArbitraryLoadsInWebContent,
		  NSAllowsArbitraryLoadsForMedia or NSAllowsLocalNetworking is also
		  present, so adding those "narrower" keys silently disables it and
		  every plain-HTTP request fails.
		-->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>

	<key>NSMicrophoneUsageDescription</key>
	<string>Voice Bridge listens through your glasses microphone when you hold the talk button.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Your speech is turned into text on this iPhone so your command can be understood.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Voice Bridge connects to your Meta glasses over Bluetooth.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Voice Bridge sends your command to the listener running on your Mac.</string>
</dict>
</plist>
