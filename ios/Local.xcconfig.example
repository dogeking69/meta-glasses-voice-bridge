// Copy this file to Local.xcconfig and fill in your own values.
// Local.xcconfig is gitignored and never committed.
//
// Find your Team ID in Xcode: Settings -> Accounts -> your Apple ID -> Team,
// or at https://developer.apple.com/account under Membership details.

PRODUCT_BUNDLE_IDENTIFIER = com.yourname.voicebridge
DEVELOPMENT_TEAM = YOURTEAMID

// From https://wearables.developer.meta.com after you create a project.
// Only needed for glasses registration; the microphone works without them.
// Leave as-is to build without Meta registration.
META_APP_ID = 0
META_CLIENT_TOKEN =
